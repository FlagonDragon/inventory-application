<!DOCTYPE html>
<html>
  <head>
    <title>Inventory App</title>
    <link type="text/css" href="/css/styles.css" rel="stylesheet">
  </head>
<body>

  <h2>Update Champion</h2>
  <form action="/edit" method="POST">
    <label for="name">Updated Name: </label>
    <input type="text" name="name" id="name" required>

    <div>Updated Organizations:</div>  
    <% orgs.forEach(org => { %>
      <input type="checkbox" id="<%=org.id%>" name="<%=org.id%>" value="<%=org.id%>">
      <label for="<%=org.id%>"> <%=org.acronym%> </label><br>
    <% }); %>

    <label for="weight">Updated Weight Class: </label>
    <select name="weight" id="weight" required>
      <% weights.forEach(weight => { %>
        <option value="<%=weight.class%>"><%=weight.class%></option>
      <% }); %>
    </select>
    
    <label for="password">Password: </label>
    <input type="text" name="password" id="password" required>
    <input type="hidden" name="type" id="type" value="<%=type%>">
    <input type="hidden" name="id" id="id" value="<%=id%>">
    <button type="submit">Submit</button>
  </form>

  <a href="/">Back to home</a>

  <form action="/edit" method="POST">
    <label for="deleteData">Delete Champion: </label>
    <select name="deleteData" id="deleteData" required>
        <option value="no">No</option>
        <option value="yes">Yes</option>
    </select>
    <label for="password">Password: </label>
    <input type="text" name="password" id="password" required>
    <input type="hidden" name="type" id="type" value="<%=type%>">
    <input type="hidden" name="id" id="id" value="<%=id%>">
    <button type="submit">Submit</button>
  </form>

</body>
</html>