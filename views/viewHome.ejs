<html>

  <head>
      <title>Inventory App</title>
  </head>

  <body>

    <div class="container">

      <h3><%= title1 %></h3> 

      <% categories1.forEach(category => { %>

        <a href="/<%=category.id%>">

          <div>
            Organization: <%=category.acronym%>
          </div>

        </a>

      <% }); %>

    </div>

    <div class="container">

      <h3><%= title2 %></h3> 

      <% categories2.forEach(category => { %>

        <a href="/<%=category.id%>">

          <div>
            Weight Class: <%=category.class%>
          </div>

        </a>

      <% }); %>

    </div>
    
  </body>

</html>