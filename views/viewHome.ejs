<html>

  <head>
      <title>Inventory App</title>
      <link type="text/css" href="/css/styles.css" rel="stylesheet">
  </head>

  <body>

    <div class="container">

      <button><a href="/create">Create</a></button>

    </div>


    <div class="container">

      <h1><%= title1 %></h3> 

      <% categories1.forEach(category => { %>

        <a href="/organization/<%=category.id%>">

          <p>
            <%=category.acronym%>
          </p>

        </a>

      <% }); %>

    </div>

    <div class="container">

      <h1><%= title2 %></h3> 

      <% categories2.forEach(category => { %>

        <a href="/weightclass/<%=category.id%>">

          <p>
            <%=category.class%>
          </p>

        </a>

      <% }); %>

    </div>
    
  </body>

</html>