<html>

  <head>
      <title>Inventory App</title>
  </head>

  <body>

    <div class="container">

      <!-- orgs have fullname column while weightclasses have class column. Ternary allows us to differentiate them -->

      <h3><%= (champs[0].fullname) ? champs[0].fullname : champs[0].class %> <button><a href="/edit?type=<%= (champs[0].fullname) ? 'organization' : 'weightclass'%>&id=<%=champs[0].id%>">Update</a></button><button><a>Delete</a></button> </h3> 

      <% champs.forEach(champ => { %>

        <a href="/champion/<%=champ.id%>">

          <div>
            Champion: <%=champ.name%>
          </div>

        </a>

      <% }); %>

    </div>
    
  </body>

</html>