<html>

  <head>
      <title>Inventory App</title>
  </head>

  <body>

    <div class="container">

      <h3><%= (champs[0].fullname) ? champs[0].fullname : champs[0].class %> <button a>Update</button><button>Delete</button> </h3> 

      <% champs.forEach(champ => { %>

        <a href="/champion/<%=champ.id%>">

          <div>
            Champion: <%=champ.name%>
          </div>

        </a>

      <% }); %>

    </div>
    
  </body>

</html>